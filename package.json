{
  "name": "root",
  "private": true,
  "devDependencies": {
    "@babel/cli": "^8.0.5",
    "@babel/core": "^8.0.5",
    "@babel/eslint-parser": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/register": "^8.0.5",
    "@larsgw/wikibase-sdk": "^10.2.1",
    "babel-plugin-istanbul": "^8.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "expect.js": "^0.3.1",
    "jsdoc": "^4.0.0",
    "lerna": "^10.0.1",
    "mocha": "^12.0.0",
    "mock-require": "^3.0.3",
    "nyc": "^18.0.0",
    "standard": "^17.0.0"
  },
  "scripts": {
    "babel": "lerna exec --parallel -- babel src -d lib --copy-files",
    "babel-mjs": "lerna exec --parallel -- babel src -d lib-mjs --copy-files --env-name mjs",
    "lint": "standard",
    "test": "lerna run test --no-bail",
    "test:update": "node scripts/tests.wikidata.js && node scripts/tests.doi.js",
    "coverage": "lerna run coverage --no-bail",
    "changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "docs": "jsdoc -c .jsdoc.js",
    "preversion": "npm run lint && npm test",
    "version": "npm run changelog",
    "postversion": "npm run babel && npm run babel-mjs"
  },
  "standard": {
    "parser": "@babel/eslint-parser"
  },
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "nx@23.2.1": true
  }
}
